{
  "schemaVersion": 1,
  "id": "altshaders",
  "version": "${version}",
  "name": "AltShaders",
  "description": "Iris-format shader pack support for Altrender.",
  "authors": ["${mod_author}"],
  "license": "${license}",
  "environment": "client",
  "entrypoints": {
    "preLaunch": ["com.coredex.altshaders.mc.boot.AltShadersPreLaunch"]
  },
  "mixins": ["altshaders.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_dependency}",
    "java": ">=${java_version}",
    "altrender": ">=${mod_version}"
  }
}
